<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- On Windows a GUI program, so a start from Explorer or Steam opens no console; a run from a terminal
             still prints there (Win32.AttachParentConsole). -->
        <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
        <!-- The executable's icon in Explorer and the taskbar, rendered with the store art (Art.WindowsIcon). -->
        <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">..\..\packaging\windows\Cubicolor.ico</ApplicationIcon>
        <RootNamespace>Cubicolor</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cubicolor.Tests" />
    </ItemGroup>

    <!-- The shaders are compiled at load time by each platform's own compiler (Metal's newLibraryWithSource,
         Windows' D3DCompile), so they ship as source, embedded in the assembly. -->
    <ItemGroup>
        <EmbeddedResource Include="Shaders\**\*" LogicalName="Shaders/%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The game's data: levels and fonts, beside the executable. -->
    <ItemGroup>
        <None Include="..\..\assets\**\*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cubicolor.Simulation\Cubicolor.Simulation.csproj" />
    </ItemGroup>

</Project>
