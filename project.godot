; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=3

[application]

config/name="Cubicolor"
run/main_scene="res://level.tscn"
config/icon="res://icon.png"
config/dark_background=false
config/hide_ui=false
config/key_forwards=16777232
config/key_backwards=16777234
config/key_left=16777231
config/key_right=16777233
config/key_restart=16777220
config/key_pause=16777217
config/normal_progress=15
config/smart_progress=0
config/genius_progress=-1

[audio]

music_muted=true
sound_muted=false
music_volume=0.31
sound_volume=0.83

[autoload]

global="*res://global.gd"

[display]

window/size/width=800
window/size/height=600
window/stretch/aspect="expand"

